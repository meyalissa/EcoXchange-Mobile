<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Matches the Flutter SplashScreen widget's own background
         (AppColors.n50) so the OS-level splash (shown before the Flutter
         engine draws its first frame) and the Flutter splash screen that
         follows it look continuous rather than a flash of plain white
         swapping to off-white. A pure white item here would also make the
         logo's own white sticker outline (launch_image.png, below)
         disappear into the background. -->
    <item android:drawable="@color/launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
