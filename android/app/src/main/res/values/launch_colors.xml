<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Kept in its own file (not colors.xml) because colors.xml is
         regenerated by `dart run flutter_launcher_icons`, and a value
         added there would be lost the next time launcher icons are
         regenerated. Matches AppColors.n50 (the Flutter SplashScreen
         widget's own background) so the native and Flutter splash
         screens look continuous. -->
    <color name="launch_background">#F8FAF5</color>
</resources>
