<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-build-only: allows plain http:// to the dev Laravel server
         at whatever LAN IP is currently active/typed into Settings ->
         Server Connection. See network_security_config.xml's own
         docblock for why this is scoped to debug builds only. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
